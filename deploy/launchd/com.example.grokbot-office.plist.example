<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example only. Nothing installs this file.

  Replace every <placeholder> before copying it to ~/Library/LaunchAgents/.
  launchd does not expand ~ or shell variables, so all paths must be absolute.

  The env file lives outside the repo and is read by node's --env-file, not by
  launchd. Existing process environment wins over the file, and the server's own
  repo-root .env loader never overwrites what --env-file already set.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.grokbot-office</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=/Users/&lt;you&gt;/.config/grokbot-office/.env</string>
    <string>/Users/&lt;you&gt;/git/grokbot-office/apps/server/dist/index.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart after a crash. A clean exit (SIGTERM shutdown, exit 0) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- launchd creates the log files, not the directory: mkdir -p ~/Library/Logs/grokbot-office -->
  <key>StandardOutPath</key>
  <string>/Users/&lt;you&gt;/Library/Logs/grokbot-office/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/&lt;you&gt;/Library/Logs/grokbot-office/server.log</string>
</dict>
</plist>
