{
  "name": "@grokbot-office/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:better-sqlite3",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@grokbot-office/shared": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
