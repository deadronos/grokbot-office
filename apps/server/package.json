{
  "name": "@grokbot-office/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && esbuild src/index.ts src/cli.ts --bundle --minify --platform=node --format=esm --target=node24 --outdir=dist --external:better-sqlite3 && cp -R drizzle dist/drizzle",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "admin": "node src/cli.ts"
  },
  "dependencies": {
    "@grokbot-office/shared": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
