# Copy to .env and fill in real values. Never commit .env.
# The real file lives outside the repo on the Mac (e.g. ~/.config/grokbot-office/.env).

# Admin token for /api/admin/* (placeholder only: the server answers 503 while this
# is unset, still "change-me", or shorter than 32 characters after trimming).
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=change-me

# Heartbeat cadence in seconds: bots should call POST /api/bots/:id/heartbeat this
# often, and a bot without a heartbeat for HEARTBEAT_TIMEOUT_SEC counts as offline.
# Both must be positive integers and the timeout must exceed the interval, otherwise
# the server refuses to start. The interval is also returned to bots on register.
HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_TIMEOUT_SEC=300

# How long a viewer session cookie stays valid, in seconds (default 28800 = 8 hours,
# maximum 604800 = one week). Must be a positive integer, otherwise the server refuses
# to start. A revoked viewer token ends its sessions immediately regardless.
SESSION_TTL_SEC=28800

# Sessions one viewer token may hold at once (default 5, maximum 50). Creating one past
# the cap revokes the oldest session of that token.
SESSION_MAX_PER_TOKEN=5

# Sessions end after this many idle seconds (default 3600, minimum 60 so it stays
# above the 25s SSE ping) and their cookie secret is replaced after SESSION_ROTATE_SEC
# (default 900), measured from the last rotation. The previous hash stays valid for
# SESSION_ROTATE_GRACE_SEC (default 60) so in-flight requests and a dropped reload
# probe still work. None of these may exceed SESSION_TTL_SEC.
SESSION_IDLE_SEC=3600
SESSION_ROTATE_SEC=900
SESSION_ROTATE_GRACE_SEC=60

# Exact browser origins allowed to call the API with credentials, comma separated
# (e.g. http://127.0.0.1:5173,http://localhost:5173). Empty means none. `*` is refused: only listed
# origins are reflected, always with Access-Control-Allow-Credentials.
CORS_ORIGINS=

# Token-bucket budgets. Per authenticated token/session: RATE_LIMIT_PER_MIN requests per
# minute with RATE_LIMIT_BURST at once. Per client address, for unauthenticated
# requests (no credentials): RATE_LIMIT_IP_PER_MIN / RATE_LIMIT_IP_BURST. Failed bearer
# attempts use a separate bucket with the same IP numbers, counted after the attempt
# fails, so a bad-token flood cannot 429 a valid or expired cookie. A session cookie
# matching no live session gets 401 and is cleared, even while a bearer flood is
# rate-limited from the same (shared loopback) address. Garbage cookies spend their own
# high per-address ceiling, RATE_LIMIT_COOKIE_PER_MIN (default 600): the token is spent
# only when the lookup fails, so a flood pays at most that many hashes/lookups a minute
# while honest stale cookies keep getting their 401. Logout is not rate-limited. A burst above its per-minute budget is refused at startup. Over the
# limit: 429 with Retry-After; /api/health is exempt. In two-port mode each port has
# its own buckets.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_IP_BURST=10
RATE_LIMIT_COOKIE_PER_MIN=600

# HSTS=true (or 1) asserts this deployment is always https, so every response - including
# on the Funnel-facing bot port - carries Strict-Transport-Security: max-age=31536000.
# Unset or false: it is only sent when the request itself hints https (an https Origin or
# Referer, or X-Forwarded-Proto: https), which a typed https URL in a browser does not.
HSTS=false

# How many days events and closed handoffs are kept. The server prunes once at startup
# and then every 24 hours; open handoffs and handoffs a live bot still links to are
# kept regardless. Must be a positive integer at most 36500 (100 years), otherwise the
# server refuses to start.
RETENTION_DAYS=90

# Port the API server listens on (127.0.0.1)
PORT=8787

# true (or 1) splits the surfaces onto two loopback listeners so a Tailscale Funnel can
# expose the bot API while the viewer stays private: PORT serves only bot register/
# heartbeat, POST /api/events and /api/health, and VIEWER_PORT serves the viewer,
# session, admin and stream routes plus the built web app. Unset or false: one port.
VIEWER_TAILNET_ONLY=false
VIEWER_PORT=8788

# Directory of the built web app served by the viewer surface (default apps/web/dist).
# Only used when it exists.
# WEB_DIST=/absolute/path/to/apps/web/dist

# SQLite database file path. Relative paths resolve against apps/server/ (not the
# cwd), so the default is apps/server/data/bot-office.db. NODE_ENV=production
# requires an absolute path.
DATABASE_PATH=./data/bot-office.db

# Bot client (scripts/bo.sh). These are read by the bot, not by the server: the API
# base URL, a bot token bound to the bot's slug, and that slug. The bot row and token
# come from `pnpm admin bot create --id <id> --name <name>` followed by
# `pnpm admin token create --kind bot --bot <id>` (the token is shown once). BO_NAME,
# BO_ROLE, BO_AVATAR and BO_POD only fill in `bo.sh register` arguments that were left
# out. bo.sh warns when BO_URL is plain http to a non-loopback host: the token would
# travel in the clear.
BO_URL=http://127.0.0.1:8787
BO_TOKEN=
BO_BOT_ID=
BO_NAME=
BO_ROLE=
BO_AVATAR=
BO_POD=

# cmux status adapter (apps/cmux-adapter), Mac only. Opt-in: anything but "true"
# leaves it disabled, and it posts nothing. It reuses BO_URL and BO_BOT_ID above;
# BO_TOKEN_FILE is an absolute path read only when BO_TOKEN is empty, so the token
# can stay out of a launchd plist. See docs/runbook-mac.md section 11.
CMUX_ADAPTER_ENABLED=false
BO_TOKEN_FILE=
# CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
# CMUX_ADAPTER_POLL_SEC=60
# Skip-by-default allowlist: report a workspace only when its custom title (or the
# basename sent as the label) starts with CMUX_ADAPTER_PREFIX (trailing space
# deliberate, so "gbother" does not match), or when its name/ref is listed in
# CMUX_ADAPTER_ALLOW. An empty prefix is not "allow all": with an empty allow list
# nothing is reported (the adapter may still heartbeat). The default prefix is "gbo ".
# CMUX_ADAPTER_PREFIX=gbo 
# CMUX_ADAPTER_ALLOW="gbo #21 nits,workspace:1000100030"
